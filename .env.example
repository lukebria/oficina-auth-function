# URL base do backend oficina-mvp-java (sem barra final), usada para consultar
# GET /api/internal/customers/{document}
BACKEND_BASE_URL=http://localhost:3000

# Mesmo valor configurado em INTERNAL_API_KEY no backend oficina-mvp-java
INTERNAL_API_KEY=troque-esta-chave-interna-em-producao

# Mesmo valor configurado em CUSTOMER_JWT_SECRET no backend oficina-mvp-java
CUSTOMER_JWT_SECRET=troque-este-segredo-de-cliente-em-producao-com-pelo-menos-32-caracteres

# Tempo de vida do token emitido, em segundos (default: 900 = 15 minutos)
TOKEN_TTL_SECONDS=900
